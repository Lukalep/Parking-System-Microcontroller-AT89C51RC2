 211          void writeLine(uint8_t* message) {      
 212   1              // Funkcija koja pise jedan string na displej - iterira kroz string i poziva funkciju writeChar za svako 
             -slovo
 213   1              uint8_t n=0;
 214   1              while(message[n]!='\0') {
 215   2                      writeChar(message[n]);
 216   2                      n++;
 217   2              }
 218   1      }
