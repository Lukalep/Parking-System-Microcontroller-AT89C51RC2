  10          void wait1s(void) {                             
  11   1              uint8_t i;
  12   1      
  13   1              // Cuvaju se podesavanja za Timer1
  14   1              // Timer0 u 16bitnom rezimu rada
  15   1              TMOD = (TMOD&0xF0) | 0x01;      
  16   1              ET0 = 0;
  17   1      
  18   1              // Polling metoda - 5ms*200=1s
  19   1              for(i=0;i<200;i++) {
  20   2                      //5ms
  21   2                      TH0 = 0xEE;                             
  22   2                      TL0 = 0x00;                             
  23   2                      TR0 = 1;                                        
  24   2                      while(!TF0); 
  25   2                      TF0 = 0;                                 
  26   2              }
  27   1              
  28   1              TR0=0;                                            
  29   1      }
  30          
  31          void wait50micro(void) {
  32   1              // Cuvaju se podesavanja za Timer1
  33   1              // Timer0 u 16bitnom rezimu rada
  34   1              TMOD = (TMOD&0xF0) | 0x01; 
  35   1              ET0 = 0;
  36   1      
  37   1              // 50us
  38   1              TH0=0xFF;
  39   1              TL0=0xD2;
  40   1              TR0=1;                                     
  41   1              while(!TF0);
  42   1              TF0=0;
  43   1              TR0=0;   
  44   1      }
  45          
  46          void wait2ms(void) {
  47   1              // Cuvaju se podesavanja za Timer1
  48   1              // Timer0 u 16bitnom rezimu rada
  49   1              TMOD = (TMOD&0xF0) | 0x01;
  50   1              ET0 = 0; 
  51   1      
  52   1              // 2ms
  53   1              TH0=0xF8;                       
  54   1              TL0=0xCD;
C51 COMPILER V8.16   DISPLAY                                                               02/09/2026 11:43:27 PAGE 2   

  55   1              TR0=1;
  56   1              while(!TF0);
  57   1              TF0=0;
  58   1              TR0=0;  
  59   1      }
