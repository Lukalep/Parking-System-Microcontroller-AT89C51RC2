 188          void writeChar(uint8_t karakter) {
 189   1              // Funkcija koja pise 1 karakter na displej 
 190   1              LCD_RS=1;
 191   1      
 192   1              LCD_EN=1;                                         
 193   1              LCD_D7=(karakter >> 7) & 0x01; 
 194   1              LCD_D6=(karakter >> 6) & 0x01; 
 195   1              LCD_D5=(karakter >> 5) & 0x01; 
 196   1              LCD_D4=(karakter >> 4) & 0x01; 
 197   1              LCD_EN=0;
 198   1      
 199   1              _nop_();
 200   1      
 201   1              LCD_EN=1;
 202   1              LCD_D7=(karakter >> 3) & 0x01; 
 203   1              LCD_D6=(karakter >> 2) & 0x01;
 204   1              LCD_D5=(karakter >> 1) & 0x01; 
 205   1              LCD_D4=(karakter >> 0) & 0x01; 
 206   1              LCD_EN=0;
 207   1      
 208   1              wait50micro();
 209   1      }
